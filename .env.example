# Copy to .env and fill in from Supabase Dashboard → Settings → API
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-anon-key"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# Optional — local Google OAuth via Lovable broker (never commit real URLs with secrets)
# VITE_LOVABLE_OAUTH_BROKER_URL=https://your-preview.lovable.app/~oauth/initiate

# Optional — staging security integration tests (see docs/SECURITY.md)
# SECURITY_TEST_URL=https://your-project-ref.supabase.co
# SECURITY_TEST_ANON_KEY=your-anon-key
# SECURITY_TEST_USER_A_EMAIL=
# SECURITY_TEST_USER_A_PASSWORD=
# SECURITY_TEST_USER_B_EMAIL=
# SECURITY_TEST_USER_B_PASSWORD=
# SECURITY_TEST_NO_INVITE_EMAIL=
# SECURITY_TEST_NO_INVITE_PASSWORD=
